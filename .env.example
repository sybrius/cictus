# ── SQL Server (source) ──────────────────────────────────────────────
# Hostname / IP of the SQL Server instance. Do NOT commit real values.
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=change-me
SQLSERVER_DATABASE=YourDatabase
# Set to true only if the server uses a self-signed certificate.
SQLSERVER_TRUST_CERT=true
# Encrypt the connection (TLS). true by default; set false for a local
# server if the test fails with "Could not connect (sequence)".
SQLSERVER_ENCRYPT=true
# Optional named instance, e.g. SQLEXPRESS (leave blank for default).
SQLSERVER_INSTANCE=

# ── MySQL (source) ───────────────────────────────────────────────────
# Hostname / IP of the MySQL server. Do NOT commit real values.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=<redacted>
MYSQL_DATABASE=YourDatabase
# Set to true only if the MySQL server requires TLS.
MYSQL_SSL=false

# ── NHost Postgres (target) ───────────────────────────────────────────
# Full Postgres connection string for the NHost database.
# Find it in NHost Dashboard → your project → Database → Connection string.
# Use the postgres://postgres:<password>@<host>:5432/postgres form.
NHOST_POSTGRES_URL=postgres://postgres:change-me@db.<your-subdomain>.nhost.run:5432/postgres

# NHost project identifiers (used for display / Hasura links, not for the
# Postgres connection itself).
NHOST_SUBDOMAIN=your-subdomain
NHOST_REGION=eu-central-1
# Hasura admin secret — only needed if you later call the Hasura metadata
# API to reload metadata / track tables after migration. Never expose it
# to the browser; it is read server-side only.
NHOST_ADMIN_SECRET=change-me

# ── Turso (history, schedules, accounts) ──────────────────────────
# The Turso database that stores migration history, schedules and
# user accounts. Create it at https://turso.tech — Database → Create.
# TURSO_DATABASE_URL is the libsql:// URL; TURSO_AUTH_TOKEN is the
# database token (Database → Generate Token). Both are secrets: put
# them in .env.local, never in git. Without them, history is not
# recorded and nobody can sign in.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOi...

# ── App ───────────────────────────────────────────────────────────────
# NEXTAUTH_URL is not used. Keep the app on localhost unless you deploy it.
# PORT=3000
